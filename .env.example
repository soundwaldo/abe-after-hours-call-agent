# --- Twilio (telephony + SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number the agent answers on (~$1/mo). The shop's real number
# forwards to this after hours / on no-answer.
TWILIO_PHONE_NUMBER=+1

# --- Owner notifications ---
# Mobile number that receives the lead-summary SMS after each call.
OWNER_MOBILE=+1

# --- AI services ---
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# --- Public address of this server (no scheme, no path) ---
# Used to build the wss:// Stream URL in the TwiML. Example:
# PUBLIC_HOST=abe-calls.up.railway.app
PUBLIC_HOST=

# --- Runtime ---
PORT=7860
